{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "rider" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "rider" }
    },
    "production": {
      "env": { "APP_VARIANT": "rider" }
    },
    "driver-development": {
      "extends": "development",
      "env": { "APP_VARIANT": "driver" }
    },
    "driver-preview": {
      "extends": "preview",
      "env": { "APP_VARIANT": "driver" }
    },
    "driver-production": {
      "extends": "production",
      "env": { "APP_VARIANT": "driver" }
    }
  },
  "submit": {
    "production": {}
  }
}
